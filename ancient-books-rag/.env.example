# Ancient Books RAG Configuration
# Copy this file to .env and fill in your values

# Required: Anthropic API key for Claude
ANTHROPIC_API_KEY=your-api-key-here

# Optional: Claude model to use (default: claude-sonnet-4-20250514)
# CLAUDE_MODEL=claude-sonnet-4-20250514

# Optional: Embedding model (default: all-MiniLM-L6-v2)
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional: Data directory (default: data)
# DATA_DIR=data

# Optional: Retrieval settings
# TOP_K=10
# MIN_RELEVANCE_SCORE=0.3

# Optional: Chunking settings
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
